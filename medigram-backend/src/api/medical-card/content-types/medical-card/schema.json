{
  "kind": "collectionType",
  "collectionName": "medical_cards",
  "info": {
    "singularName": "medical-card",
    "pluralName": "medical-cards",
    "displayName": "Medical Card"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "content": {
      "type": "richtext"
    },
    "category": {
      "type": "string"
    },
    "imageUrl": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "source": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "required": false
    },
    "subcategory": {
      "type": "string"
    },
    "thumbnail": {
      "type": "string"
    },
    "aiImagePrompt": {
      "type": "text"
    },
    "likes": {
      "type": "json",
      "default": "[]"
    },
    "commentCount": {
      "type": "integer",
      "default": 0
    },
    "shareCount": {
      "type": "integer",
      "default": 0
    },
    "isPremium": {
      "type": "boolean",
      "default": false
    }
  }
}
