ADMIN_GENERATE_CARD_PATH=/admin/ai/generate
ADMIN_CATEGORY_REFRESH_PATH=/admin/categories/sync

# Timeouts
REQUEST_TIMEOUT_MS=15000

# Development
USE_MOCK_DATA=false
