# API Configuration
API_BASE_URL=http://localhost:1337/api
API_ASSETS_BASE_URL=http://localhost:1337

# API Endpoints
MEDICAL_CARDS_PATH=/medical-cards
MEDICAL_CARDS_POPULATE=*
CATEGORIES_PATH=/categories
PAYMENT_CHECKOUT_PATH=/payments/checkout
